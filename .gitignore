# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# If you find yourself ignoring temporary files generated by your text editor
# or operating system, you probably want to add a global ignore instead:
#   git config --global core.excludesfile '~/.gitignore_global'

# Ignore bundler config.
/.bundle

# Ignore all environment files (except templates).
/.env*
!/.env*.erb

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets
/public/uploads/*
!/public/uploads/.keep

/config/mongoid.yml

# Ignore master key for decrypting credentials and more.
/config/master.key

# Video sources and final deliverables are versioned; local tooling and drafts are not.
/mi-video/node_modules/
/mi-video/exports/*
!/mi-video/exports/lynx-note-tutorial.mp4
!/mi-video/exports/lynx-note-portada.png
!/mi-video/exports/lynx-note-subtitulos.srt
!/mi-video/exports/youtube-descripcion.txt
!/mi-video/exports/quality-report.json
!/mi-video/exports/audio-analysis.json
/mi-video/.venv/
/mi-video/public/captures/*
!/mi-video/public/captures/*.mp4
!/mi-video/public/captures/note.png
!/mi-video/public/captures/verification.json
/mi-video/.remotion/
/mi-video/scripts/__pycache__/
